app/build/
build/
.gradle/
.kotlin/

# Saída regenerável do harness de verificação (o golden versionado vem em verification/golden/, T26)
/verification/*.png
/verification/routes.txt

# AAR do sherpa-onnx: baixado e conferido por SHA256 pelo app/build.gradle.kts (NM-T1)
/app/libs/*.aar
/app/libs/*.part

# KeyFlow API (Rust, monorepo — api/)
api/target/

# SDK local e service token do Cloudflare Access (staging). Nunca versionar.
/local.properties

# Chaves e credenciais: nunca versionar (o repositório é público). A chave de upload da Play e os keystores ficam FORA do repositório (~/.keyflow/android/, ver .specs/codebase/ENVIRONMENT.md).
*.jks
*.keystore
# exceção: a chave de debug é pública de propósito (assinatura igual em toda máquina; não serve para a loja)
!app/debug.keystore
*.p12
*.pem
upload-keystore.properties
!api/tests/fixtures/test_service_account_key.pem
.env
.env.*
!.env.example
google-services.json

# Arquivos da coordenação dos agentes (tarefas e relatórios locais)
.equipe/
__pycache__/

# JNI do termlib: artefato do CI com hash fixado; saída local do módulo vendorizado.
/app/libs/termlib-jni-*.zip
/third_party/termlib/build/
