<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- DLM-04: o downloader de modelos pergunta se a rede é medida antes de baixar. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Download dos modelos de voz em primeiro plano (ModelDownloadService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id" />

        <!-- Launcher -->
        <activity
            android:name=".ui.SetupActivity"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Teclado KeyFlow: QWERTY + botão de microfone integrado -->
        <service
            android:name=".ime.KeyFlowKeyboardService"
            android:label="@string/ime_keyboard_label"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method_keyboard" />
        </service>

        <!-- Activity transparente que abre o seletor de teclados (atalho de 3 toques da orbe) -->
        <activity
            android:name=".ui.ImePickerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:taskAffinity=""
            android:excludeFromRecents="true" />

        <!-- Production overlay + microphone foreground service -->
        <service
            android:name=".overlay.OverlayService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Download dos modelos de voz: notificação de progresso e processo vivo com o app fechado. -->
        <service
            android:name=".data.models.ModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Transcrição local (native-voice-models, NM-T8): processo próprio — pico de RAM do modelo e
             crash nativo ficam longe do teclado e da orbe. -->
        <service
            android:name=".transcription.local.InferenceService"
            android:process=":inference"
            android:exported="false" />

        <!-- Raciocínio local (reasoning-models, RSN-T5): processo próprio, separado do :inference — o modelo de fala fica
             residente para o ditado e um LLM de GB lá dentro derrubaria a transcrição por falta de memória. -->
        <service
            android:name=".reasoning.local.ReasoningService"
            android:process=":reasoning"
            android:exported="false" />

    </application>
</manifest>
