<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup (Android 11 e anteriores). As prefs cifradas (`keyflow_secure`) ficam FORA do backup: o
  keyset do Tink mora nelas, mas a chave mestra que o decifra mora no Keystore e não é exportável — logo,
  restaurar as prefs sem a chave só produz `AEADBadTagException` em toda leitura (crash em loop até
  "limpar dados"; achado no Galaxy A32, 2026-09-07). Sem elas no backup, o app recomeça pedindo o token,
  que é o comportamento correto. `SecurePrefs` ainda tem recuperação pra quem já está com o estado quebrado.
-->
<full-backup-content>
    <!-- A identidade anônima e as preferências do app ficam claras e acompanham a reinstalação; o Block Store é o fallback. -->
    <exclude domain="sharedpref" path="keyflow_secure.xml" />
    <!-- O cofre das credenciais de IA (auth/): mesma razão, chave de Keystore própria — ver SecureCredentialStore. -->
    <exclude domain="sharedpref" path="keyflow_auth.xml" />
    <!--
      Modelos de voz locais (STO-01): centenas de MB, muito acima da cota do backup (~25 MB), e
      re-baixáveis do catálogo. `model-tmp` é onde os downloads ficam antes da instalação, e
      `model-downloads.json` é a fila deles: restaurada em outro aparelho, retomaria downloads sozinha.
    -->
    <exclude domain="file" path="models" />
    <exclude domain="file" path="model-downloads.json" />
    <exclude domain="external" path="model-tmp" />
    <!-- O registro de ações do agente (agent-harness): é deste aparelho — as chamadas de "desfazer" apontam para skins daqui. Não guarda segredo. -->
    <exclude domain="file" path="agent/actions.jsonl" />
</full-backup-content>
