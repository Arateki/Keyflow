<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: backup na nuvem e transferência device-to-device. Mesma exclusão do `backup_rules.xml` —
  ver o comentário de lá; a transferência D2D também não leva a chave do Keystore junto.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- A identidade anônima e as preferências do app acompanham o backup; os prefs cifrados abaixo não. -->
        <exclude domain="sharedpref" path="keyflow_secure.xml" />
        <exclude domain="sharedpref" path="keyflow_auth.xml" />
        <!-- Modelos de voz locais (STO-01): grandes e re-baixáveis — ver o backup_rules.xml. -->
        <exclude domain="file" path="models" />
        <exclude domain="file" path="model-downloads.json" />
        <exclude domain="external" path="model-tmp" />
        <!-- Registro de ações do agente: deste aparelho — ver o backup_rules.xml. -->
        <exclude domain="file" path="agent/actions.jsonl" />
        <!-- Histórico da bancada de modelos: medidas deste aparelho — ver o backup_rules.xml. -->
        <exclude domain="file" path="bancada" />
        <!-- Aba Computador: chaves SSH e senhas ficam no cofre `keyflow_auth` (excluído acima) e no Keystore; o known_hosts é deste aparelho. -->
        <exclude domain="file" path="known_hosts" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="keyflow_secure.xml" />
        <exclude domain="sharedpref" path="keyflow_auth.xml" />
        <exclude domain="file" path="models" />
        <exclude domain="file" path="model-downloads.json" />
        <exclude domain="external" path="model-tmp" />
        <exclude domain="file" path="agent/actions.jsonl" />
        <exclude domain="file" path="bancada" />
        <exclude domain="file" path="known_hosts" />
    </device-transfer>
</data-extraction-rules>
