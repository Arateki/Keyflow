<?xml version="1.0" encoding="utf-8"?>
<input-method
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:supportsSwitchingToNextInputMethod="true">
    <!-- 1 subtype só de propósito (decisão do Yan, 2026-07-02, revertendo o KC-T9): declarar PT/EN/ES
         como subtypes do sistema fazia o seletor "Trocar teclado" do Android listar "KeyFlow" repetido
         (um por idioma habilitado) e a troca dependia da tela de Idiomas do sistema — experiência ruim,
         diferente do Gboard, que gerencia idioma inteiramente dentro do próprio app. O globo agora cicla
         pt→en→es→pt via `Settings.keyboardLanguage` (`KeyFlowKeyboardService`), sem depender de subtype
         nenhum — este único subtype só existe pra declarar o modo "keyboard" ao Android. -->
    <subtype
        android:imeSubtypeLocale="pt_BR"
        android:imeSubtypeMode="keyboard" />
</input-method>
