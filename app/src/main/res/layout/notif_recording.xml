<?xml version="1.0" encoding="utf-8"?>
<!-- Notificação Ateliê de gravação (NOTIF-01..03). RemoteViews: só views suportadas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#2B2720"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/notif_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@android:drawable/ic_btn_speak_now"
        android:tint="#4E9683"
        android:contentDescription="KeyFlow" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/notif_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Gravando"
                android:textColor="#F1E7C9"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/notif_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" · "
                android:textColor="#9C9072"
                android:textSize="14sp" />

            <Chronometer
                android:id="@+id/notif_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#C3B996"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/notif_wave"
            android:layout_width="96dp"
            android:layout_height="20dp"
            android:layout_marginTop="6dp"
            android:src="@drawable/notif_waveform"
            android:contentDescription="@null" />
    </LinearLayout>

    <TextView
        android:id="@+id/notif_pause"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pausar"
        android:textColor="#F4ECCF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="@drawable/notif_chip_teal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_marginEnd="8dp" />

    <TextView
        android:id="@+id/notif_stop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Parar"
        android:textColor="#F4ECCF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="@drawable/notif_chip_record"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />
</LinearLayout>
