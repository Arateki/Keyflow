<?xml version="1.0" encoding="utf-8"?>
<!-- Prova de altura NTF-T1 (só debug, descartável): a linha [botão][orbe][botão] de 48 dp do design §6. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/spike_root"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center"
    android:orientation="horizontal">

    <ImageButton
        android:id="@+id/spike_btn_esq"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@null"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/spike_glifo"
        android:visibility="invisible" />

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp">

        <ImageView
            android:id="@+id/spike_orb"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="4dp"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/spike_btn_dir"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@null"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/spike_glifo"
        android:visibility="invisible" />
</LinearLayout>
