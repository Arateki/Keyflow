<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Hospedeiro de viewport para a orbe, em processo separado do IME. -->
        <activity android:name=".ui.OrbeDoTecladoProbeActivity" android:exported="true" android:process=":probe" />
        <activity android:name=".DebugSimulatedPurchaseActivity" android:exported="false" />
        <!-- Smoke de fundação (T1), só em debug, não exportado, sem launcher. -->
        <activity
            android:name=".ComposeSmokeActivity"
            android:exported="false" />

        <!-- Harness de verificação (T7), só em debug. exported p/ `adb am start` via shell. -->
        <activity
            android:name=".ui.gallery.GalleryActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

        <!-- Campo de teste p/ capturar o IME real (T25), só em debug. exported p/ `am start`. -->
        <activity
            android:name=".ui.ImeProbeActivity"
            android:exported="true" />

        <!-- O mesmo campo num processo separado do teclado, como num app de verdade (ImeProbeRemoteActivity). -->
        <activity
            android:name=".ui.ImeProbeRemoteActivity"
            android:exported="true"
            android:process=":probe" />

        <!-- Prova de altura da notificação (NTF-T1), só em debug e descartável. -->
        <service android:name=".notificacao.SpikeCliqueService" android:exported="false" />
    </application>
</manifest>
